#!/usr/bin/env bash

set -euo pipefail

backup_directory=/var/backups/tjoerah-pos
timestamp=$(date +%Y%m%d-%H%M%S)
backup_file="$backup_directory/tjoerah-pos-$timestamp.dump"

umask 077
install -d -m 0700 -o postgres -g postgres "$backup_directory"
runuser -u postgres -- pg_dump --format=custom --file="$backup_file" tjoerah_pos
pg_restore --list "$backup_file" >/dev/null

find "$backup_directory" -maxdepth 1 -type f -name 'tjoerah-pos-*.dump' -mtime +7 -delete

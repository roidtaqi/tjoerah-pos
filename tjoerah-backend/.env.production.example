APP_NAME="Tjoerah POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tjoerah-production
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_APP_MAX_CONNECTIONS=100

FILESYSTEM_DISK=local
ATTENDANCE_FILESYSTEM_DISK=local
ATTENDANCE_PHOTO_MAX_KILOBYTES=1024

# Isi bagian ini dan ubah ATTENDANCE_FILESYSTEM_DISK=s3 jika memakai
# object storage S3-compatible untuk foto absensi.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

JWT_SECRET=
JWT_TTL=480
CORS_ALLOWED_ORIGINS=https://pos.example.com
SEED_DEMO_DATA=false
